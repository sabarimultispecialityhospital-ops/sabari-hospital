# Sabari Hospitals — appointment API server configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Port the appointment API server listens on.
PORT=8787

# Restrict CORS to the site's real origin in production, e.g. https://sabarihospitals.com
CORS_ORIGIN=http://localhost:5174

# --- WhatsApp Business Cloud API (Meta) ---
# The hospital's destination WhatsApp number, in E.164 format without the leading '+'.
WHATSAPP_PHONE_NUMBER=917550305675

# Permanent/system-user access token for your WhatsApp Business app.
WHATSAPP_ACCESS_TOKEN=

# The Cloud API "from" phone number id (found in Meta App Dashboard > WhatsApp > API Setup).
WHATSAPP_PHONE_NUMBER_ID=
