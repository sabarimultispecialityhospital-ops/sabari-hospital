# Sabari Hospitals — appointment API server configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Port the appointment API server listens on.
PORT=8787

# Restrict CORS to the site's real origin in production, e.g. https://sabarihospital.in
CORS_ORIGIN=http://localhost:5174

# --- SMTP Email Provider Configuration (Render Environment Variables) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
APPOINTMENT_RECEIVER=sabarimultispecialityhospital@gmail.com
